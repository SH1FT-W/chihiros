{
  "config": {
    "flow_title": "{name}",
    "step": {
      "confirm": {
        "description": "Set up {name}?",
        "data": {
          "pump_count": "Number of pump channels",
          "device_type": "Connected lamp"
        }
      },
      "user": {
        "title": "Choose a Chihiros device",
        "data": {
          "address": "Device",
          "pump_count": "Number of pump channels (dosing pump only)",
          "device_type": "Connected lamp (Commander 1 only)"
        }
      },
      "reconfigure": {
        "description": "Change the number of pump channels of {name}. Entities of channels that are no longer used are removed.",
        "data": {
          "pump_count": "Number of pump channels"
        }
      }
    },
    "abort": {
      "already_configured": "This device is already set up.",
      "no_devices_found": "No supported Chihiros device in Bluetooth range.",
      "not_supported": "This Chihiros device is not supported (LED lamps and dosing pump only).",
      "reconfigure_successful": "Settings saved.",
      "nothing_to_reconfigure": "This lamp has nothing to reconfigure."
    }
  },
  "entity": {
    "light": {
      "light": {
        "state_attributes": {
          "auto_mode": {
